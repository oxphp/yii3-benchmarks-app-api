# OxPHP worker mode. OxPHP is configured through environment variables only.
LISTEN_ADDR=0.0.0.0:8080
DOCUMENT_ROOT=/app/public
WORKER_MODE_ENABLED=true
ENTRY_FILE=/app/worker-oxphp.php
PHP_WORKERS=20
# Wait up to 30 s for a free worker, like FrankenPHP max_wait_time and RoadRunner allocate_timeout.
QUEUE_WAIT_TIMEOUT_MS=30000
LOG_LEVEL=warn
