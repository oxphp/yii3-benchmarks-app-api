# OxPHP framework mode: every request bootstraps public/index.php afresh.
LISTEN_ADDR=0.0.0.0:8080
DOCUMENT_ROOT=/app/public
ENTRY_FILE=index.php
PHP_WORKERS=20
# Wait up to 30 s for a free worker, like FrankenPHP max_wait_time and RoadRunner allocate_timeout.
QUEUE_WAIT_TIMEOUT_MS=30000
LOG_LEVEL=warn
